# FlatSAM2 settings. setup.sh copies this to .env (gitignored); the defaults work as-is.
# Relative paths are relative to the repo root. Real environment variables override .env.
# Leave a line commented out to keep the default.

# --- outputs ----------------------------------------------------------------
OUTPUT_DIRECTORY=results/
VIS_DIRECTORY=vis/

# --- datasets (only for `demo.py dataset`) ----------------------------------
POT_BASE=data/POT-210/
PT_BASE=data/PlanarTrack/PlanarTrack-Data/
PT_INITFIX_DIR=data/PlanarTrack/PlanarTrack_init_reannotation/

# --- model caches + Hugging Face login --------------------------------------
# default ~/.cache/huggingface and ~/.cache/torch
# HF_HOME=
# TORCH_HOME=
# without HF_TOKEN, setup.sh asks once and stores the token in $HF_HOME/token
# HF_TOKEN=

# --- demo defaults ----------------------------------------------------------
DEMO_CONFIG=configs/tracker/loma_samh_matchnaming.py
DEMO_DATASET=pot
DEMO_SEQUENCE=V01_7

