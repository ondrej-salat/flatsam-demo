  author = {Kristan, Matej and Leonardis, Ale{\v s} and Matas, Ji{\v r}i and Felsberg, Michael and Pflugfelder, Roman and {\v C}ehovin, Luka and Voj{\'i}{\v r}, Tom{\'a}{\v s} and H{\"a}ger, Gustav and Luke{\v z}i{\v c}, Alan and others},
  year = 2016,
  pages = {777--823},
  publisher = {Springer International Publishing},
